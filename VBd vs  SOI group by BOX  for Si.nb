Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "definitions", " ", "first"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "Constants"}], "-", 
     RowBox[{"renamed", " ", "to", " ", "remove", " ", "underscores"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aCm", "=", 
     RowBox[{"7.03", "*", 
      RowBox[{"10", "^", "5"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bVcm", "=", 
     RowBox[{"1.468", "*", 
      RowBox[{"10", "^", "6"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"umToCm", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "4"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Function", " ", "to", " ", "find", " ", "gamma"}], "-", 
     RowBox[{"using", " ", "CamelCase", " ", "names"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaFromTs", "[", 
      RowBox[{"tsUm_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ats", ",", "gamma"}], "}"}], ",", 
       RowBox[{
        RowBox[{"ats", "=", 
         RowBox[{"aCm", "*", "tsUm", "*", "umToCm"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ats", "<=", "1"}], ",", 
          RowBox[{"Return", "[", "Indeterminate", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gamma", "/.", " ", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ats", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{"-", "gamma"}], "]"}], "-", 
                RowBox[{"gamma", "*", 
                 RowBox[{"ExpIntegralE", "[", 
                  RowBox[{"1", ",", "gamma"}], "]"}]}]}], ")"}]}], "-", "1"}],
             "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"gamma", ",", "1", ",", "0.0001", ",", "100"}], "}"}]}], 
          "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Breakdown", " ", "Voltage", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"breakdownVoltage", "[", 
      RowBox[{
       RowBox[{"tsUm_", "?", "NumericQ"}], ",", 
       RowBox[{"toxUm_", "?", "NumericQ"}], ",", 
       RowBox[{"epsRatio_", ":", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gamma", ",", "tEffCm"}], "}"}], ",", 
       RowBox[{
        RowBox[{"gamma", "=", 
         RowBox[{"gammaFromTs", "[", "tsUm", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tEffCm", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"tsUm", "/", "2.0"}], "+", 
            RowBox[{"epsRatio", "*", "toxUm"}]}], ")"}], "*", "umToCm"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumericQ", "[", "gamma", "]"}], ",", 
          RowBox[{"bVcm", "*", 
           RowBox[{"tEffCm", "/", "gamma"}]}], ",", "Indeterminate"}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "Oxide", " ", "Limit"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"oxideLimit", "[", "ts_", "]"}], ":=", 
     RowBox[{"600.0", "*", 
      RowBox[{"(", 
       RowBox[{"2.0", "+", 
        RowBox[{"ts", "/", "6.0"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "Plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plot", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"breakdownVoltage", "[", 
         RowBox[{"ts", ",", "2.0"}], "]"}], ",", 
        RowBox[{"breakdownVoltage", "[", 
         RowBox[{"ts", ",", "4.0"}], "]"}], ",", 
        RowBox[{"breakdownVoltage", "[", 
         RowBox[{"ts", ",", "6.0"}], "]"}], ",", 
        RowBox[{"oxideLimit", "[", "ts", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ts", ",", "0.01", ",", "100"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1400"}], "}"}]}], ",", 
      RowBox[{"ScalingFunctions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Log\>\"", ",", "None"}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<SOI thickness $t_s$ ($\\mu$m)\>\"", 
         ",", "\"\<Breakdown voltage $V_{BR}$ (V)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "Automatic", ",", "Automatic", ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<t_ox=2.0um\>\"", ",", "\"\<t_ox=4.0um\>\"", 
         ",", "\"\<t_ox=6.0um\>\"", 
         ",", "\"\<2-$\\mu$m oxide limit ($E_{ox}=600$ V/$\\mu$m)\>\""}], 
        "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Reproduction of Fig. 4: thin-SOI RESURF breakdown \
model\>\""}], ",", 
      RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Generate", " ", "the", " ", "data", " ", "points"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "Logarithmic", " ", "spacing", " ", "instead", " ", "of", " ",
      "linear"}], "*)"}], 
   RowBox[{
    RowBox[{"tsValues", "=", 
     RowBox[{"10", "^", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Log10", "[", "0.015", "]"}], ",", 
        RowBox[{"Log10", "[", "100", "]"}], ",", "0.05"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "data", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data1", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ts", ",", 
         RowBox[{"breakdownVoltage", "[", 
          RowBox[{"ts", ",", "2.0"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ts", ",", "tsValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"data2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ts", ",", 
         RowBox[{"breakdownVoltage", "[", 
          RowBox[{"ts", ",", "4.0"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ts", ",", "tsValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"data3", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ts", ",", 
         RowBox[{"breakdownVoltage", "[", 
          RowBox[{"ts", ",", "6.0"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ts", ",", "tsValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limitData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ts", ",", 
         RowBox[{"oxideLimit", "[", "ts", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ts", ",", "tsValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plotting", " ", "code", " ", "remains", " ", "the", " ", "same"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plot", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data1", ",", "data2", ",", "data3", ",", "limitData"}], "}"}],
       ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1400"}], "}"}]}], ",", 
      RowBox[{"ScalingFunctions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Log\>\"", ",", "None"}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<SOI thickness $t_s$ ($\\mu$m)\>\"", 
         ",", "\"\<Breakdown voltage $V_{BR}$ (V)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<\[FilledSquare]\>\"", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<\[FilledDiamond]\>\"", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<\[FilledCircle]\>\"", ",", "10"}], "}"}], ",", 
         "None"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "Automatic", ",", "Automatic", ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<$t_{ox}=2.0\\,\\mu$m\>\"", 
         ",", "\"\<$t_{ox}=4.0\\,\\mu$m\>\"", 
         ",", "\"\<$t_{ox}=6.0\\,\\mu$m\>\"", 
         ",", "\"\<2-$\\mu$m oxide limit ($E_{ox}=600$ V/$\\mu$m)\>\""}], 
        "}"}]}], ",", 
      RowBox[{
      "PlotLabel", 
       "->", "\"\<Reproduction of Fig. 4: thin-SOI RESURF breakdown \
model\>\""}], ",", 
      RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<fig4_reproduction.png\>\"", ",", "plot", ",", "\"\<PNG\>\"", 
     ",", 
     RowBox[{"ImageResolution", "->", "220"}]}], "]"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", "Export", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<fig4_reproduction.png\>\"", ",", "plot", ",", "\"\<PNG\>\"", 
     ",", 
     RowBox[{"ImageResolution", "->", "220"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", "Export", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<fig4_reproduction.png\>\"", ",", "plot", ",", "\"\<PNG\>\"", 
     ",", 
     RowBox[{"ImageResolution", "->", "220"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9932549183447113`*^9, 3.9932549256075993`*^9}, {
